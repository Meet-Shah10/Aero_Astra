# ── Node ──────────────────────────────────────────────────────────────────────
node_modules/
dist/
.cache/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.eggs/
venv/
.venv/
*.out

# ── Environment & secrets ─────────────────────────────────────────────────────
.env
.env.*

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.claude/
.gemini/

# ── Large binary assets ───────────────────────────────────────────────────────
*.glb
*.gltf

# ── MLX local model weights (several GB each — download via mlx_setup.sh) ────
backend/models/llama3.1-8b-4bit/
backend/models/llama3.2-1b-4bit/
backend/models/llama3.2-3b-4bit/
backend/models/mistral-7b-4bit/
backend/models/mistral-nemo-4bit/

# ── ChromaDB vectorstore binaries (regenerated by first backend run) ──────────
backend/athena/rag/vectorstore/*/data_level0.bin
backend/athena/rag/vectorstore/*/header.bin
backend/athena/rag/vectorstore/*/length.bin
backend/athena/rag/vectorstore/*/link_lists.bin

# ── Data, model artifacts & logs (large / regenerable) ───────────────────────
backend/data/
backend/results/
backend/logs/

# Track production model only; ignore legacy/large experimental artifacts
backend/models/sentinel_if.joblib
backend/models/sentinel_if.pkl
backend/models/sentinel_lstm.pt
backend/models/sentinel_lstm_scaler.joblib
backend/models/sentinel_ocsvm.joblib
backend/models/sentinel_supervised.pkl
!backend/models/sentinel_production.pkl
!backend/models/sentinel_scaler.joblib
!backend/models/sentinel_ensemble.json

# ── Scratch / utility scripts (not part of the core project) ─────────────────
auto_resume.py
robust_download.py
sandbox_test_server.py
test_sandbox.html
patch*.cjs
patch_*.cjs
test-import.js
*.log
